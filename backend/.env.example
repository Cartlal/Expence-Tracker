# Copy this file to ".env" and fill in your own values.
# ".env" is ignored by git so your real connection string is never committed.

# MongoDB connection string.
# - Local MongoDB:  mongodb://127.0.0.1:27017/expense-tracker
# - MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster-url>/expense-tracker
MONGO_URI=mongodb://127.0.0.1:27017/expense-tracker

# Port the Express server will listen on.
PORT=5000
